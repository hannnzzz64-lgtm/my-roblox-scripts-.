-- Fungsi untuk membuat tombol
local function CreateButton(text, callback, yPos, color)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(0.9, 0, 0, 45)
    Button.Position = UDim2.new(0.05, 0, 0, yPos)
    Button.Text = text
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.TextScaled = true
    Button.Font = Enum.Font.GothamSemibold
    Button.BackgroundColor3 = color or Color3.fromRGB(30, 144, 255)
    Button.BorderSizePixel = 0
    Button.Parent = ScrollingFrame
    
    -- Efek hover
    Button.MouseEnter:Connect(function()
        Button.BackgroundColor3 = Color3.fromRGB(70, 184, 255)
        Button.Size = UDim2.new(0.92, 0, 0, 47)
    end)
    
    Button.MouseLeave:Connect(function()
        Button.BackgroundColor3 = color or Color3.fromRGB(30, 144, 255)
        Button.Size = UDim2.new(0.9, 0, 0, 45)
    end)
    
    Button.MouseButton1Click:Connect(callback)
    return Button
end

-- Fungsi untuk membuat toggle
local function CreateToggle(text, callback, yPos, defaultState)
    local ToggleFrame = Instance.new("Frame")
    ToggleFrame.Size = UDim2.new(0.9, 0, 0, 40)
    ToggleFrame.Position = UDim2.new(0.05, 0, 0, yPos)
    ToggleFrame.BackgroundTransparency = 1
    ToggleFrame.Parent = ScrollingFrame
    
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.7, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.TextScaled = true
    Label.Font = Enum.Font.GothamSemibold
    Label.Parent = ToggleFrame
    
    local ToggleButton = Instance.new("TextButton")
    ToggleButton.Size = UDim2.new(0.2, 0, 0.8, 0)
    ToggleButton.Position = UDim2.new(0.8, 0, 0.1, 0)
    ToggleButton.BackgroundColor3 = defaultState and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    ToggleButton.Text = defaultState and "ON" or "OFF"
    ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleButton.TextScaled = true
    ToggleButton.Font = Enum.Font.GothamBold
    ToggleButton.BorderSizePixel = 0
    ToggleButton.Parent = ToggleFrame
    
    local state = defaultState or false
    
    ToggleButton.MouseButton1Click:Connect(function()
        state = not state
        ToggleButton.BackgroundColor3 = state and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
        ToggleButton.Text = state and "ON" or "OFF"
        callback(state)
    end)
    
    return ToggleButton, ToggleFrame
end

-- Fungsi Bypass Active
local function BypassActive()
    local function antiKick()
        for i, v in pairs(getconnections(LocalPlayer.PlayerGui.ChildAdded)) do
            if v and v.Function then
                v:Disable()
            end
        end
    end
    
    -- Bypass untuk remote events
    for _, v in pairs(ReplicatedStorage:GetChildren()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            if v.Name:match("Kick") or v.Name:match("Ban") or v.Name:match("Detection") then
                v:Destroy()
            end
        end
    end
    
    -- Anti kick dari server
    LocalPlayer.PlayerGui.ChildAdded:Connect(function(child)
        if child.Name:match("Kick") or child.Name:match("Ban") then
            child:Destroy()
        end
    end)
    
    -- Bypass detection
    local oldSend = game:GetService("ReplicatedStorage").Send
    if oldSend then
        oldSend:Destroy()
    end
    
    antiKick()
    print("✅ Bypass Active Berhasil!")
end

-- Auto Farm Marshmellow
local farmRunning = false
local farmCoroutine = nil

local function AutoFarmMarshmellow(state)
    farmRunning = state
    
    if farmCoroutine then
        coroutine.close(farmCoroutine)
        farmCoroutine = nil
    end
    
    if state then
        farmCoroutine = coroutine.create(function()
            while farmRunning do
                pcall(function()
                    -- Cari marshmellow terdekat
                    local nearestMarsh = nil
                    local nearestDist = math.huge
                    
                    for _, v in pairs(Workspace:GetChildren()) do
                        if v.Name:match("Marshmellow") or v.Name:match("Marshmallow") then
                            if v:IsA("BasePart") or v:IsA("Model") then
                                local pos = v:IsA("BasePart") and v.Position or v.PrimaryPart and v.PrimaryPart.Position
                                if pos then
                                    local dist = (pos - Character.HumanoidRootPart.Position).Magnitude
                                    if dist < nearestDist then
                                        nearestDist = dist
                                        nearestMarsh = v
                                    end
                                end
                            end
                        end
                    end
                    
                    if nearestMarsh then
                        -- Move to marshmellow
                        Humanoid:MoveTo(nearestMarsh:IsA("BasePart") and nearestMarsh.Position or nearestMarsh.PrimaryPart.Position)
                        
                        -- Collect marshmellow
                        if nearestMarsh:IsA("BasePart") and (nearestMarsh.Position - Character.HumanoidRootPart.Position).Magnitude < 5 then
                            local fire = Instance.new("Fire")
                            fire.Parent = nearestMarsh
                            fire.Size = 5
                            fire.Heat = 10
                            
                            wait(1)
                            fire:Destroy()
                            
                            -- Pindah ke safe zone
                            local safeZone = Workspace:FindFirstChild("SafeZone") or Workspace:FindFirstChild("Spawn")
                            if safeZone then
                                local pos = safeZone:IsA("BasePart") and safeZone.Position or safeZone.PrimaryPart.Position
                                Humanoid:MoveTo(pos)
                            end
                        end
                    end
                end)
                wait(0.5)
            end
        end)
        coroutine.resume(farmCoroutine)
    end
end

-- Auto Buy Cell dan Spawn Motor
local function AutoBuyAndSpawn()
    pcall(function()
        -- Buy Cell
        local shopGUI = LocalPlayer.PlayerGui:FindFirstChild("Shop")
        if shopGUI then
            local buyButton = shopGUI:FindFirstChild("BuyCell") or shopGUI:FindFirstChild("CellButton")
            if buyButton then
                buyButton:Fire()
                print("✅ Auto Buy Cell Berhasil!")
            end
        end
        
        -- Spawn Motor
        local spawnMotor = ReplicatedStorage:FindFirstChild("SpawnMotor") or ReplicatedStorage:FindFirstChild("MotorSpawn")
        if spawnMotor then
            if spawnMotor:IsA("RemoteEvent") then
                spawnMotor:FireServer()
            elseif spawnMotor:IsA("RemoteFunction") then
                spawnMotor:InvokeServer()
            end
            print("✅ Auto Spawn Motor Berhasil!")
        end
        
        -- Cari Buya Marshmellow
        local buya = Workspace:FindFirstChild("Buya") or Workspace:FindFirstChild("MarshmellowBuya")
        if buya then
            local motor = Character:FindFirstChild("Motor") or Character:FindFirstChild("Vehicle")
            if motor then
                motor:Destroy()
            end
            
            local newMotor = Instance.new("Model")
            newMotor.Name = "MotorBuya"
            newMotor.Parent = Character
            
            local motorPart = Instance.new("Part")
            motorPart.Size = Vector3.new(5, 3, 10)
            motorPart.Position = Character.HumanoidRootPart.Position + Vector3.new(0, 0, 5)
            motorPart.Parent = newMotor
            
            local weld = Instance.new("Weld")
            weld.Part0 = Character.HumanoidRootPart
            weld.Part1 = motorPart
            weld.C0 = CFrame.new(0, -1, -3)
            weld.Parent = Character.HumanoidRootPart
            
            print("✅ Motor Buya Berhasil Di-Spawn!")
        end
    end)
end

