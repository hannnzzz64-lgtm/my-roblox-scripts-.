-- ================================
-- FITUR AUTO FARM
-- ================================

local isFarming = false
local farmLoop = nil
local toggleButton = nil

local function sendKeyE()
    game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.5)
    game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

local function startFarming()
    if isFarming then return end
    isFarming = true
    if toggleButton then
        toggleButton.Text = "⏹ Stop Farm"
        toggleButton.BackgroundColor3 = Color3.new(0.8, 0.2, 0.2)
    end

    farmLoop = game:GetService("RunService").Stepped:Connect(function()
        if not isFarming then return end
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        -- Kirim remote event untuk Box Job
        local remote = game:GetService("ReplicatedStorage"):FindFirstChild("RemoteEvents")
        if remote and remote:FindFirstChild("FetchGUI") then
            remote.FetchGUI:FireServer("Box Job")
        end

        -- Lokasi 1: Farm Box Job
        hrp.CFrame = CFrame.new(Vector3.new(-552.4525146484375, 3.5371451377868652, -83.8554458618164))
        task.wait(0.5)
        sendKeyE()
        task.wait(4.5)

        -- Lokasi 2
        hrp.CFrame = CFrame.new(Vector3.new(-401.3119201660156, 3.4121932983398438, -72.4224853515625))
        task.wait(0.5)
        sendKeyE()
        task.wait(4.5)
    end)
end

local function stopFarming()
    isFarming = false
    if farmLoop then
        farmLoop:Disconnect()
        farmLoop = nil
    end
    if toggleButton then
        toggleButton.Text = "▶ Start Farm"
        toggleButton.BackgroundColor3 = Color3.new(0.2, 0.6, 0.2)
    end
end

-- Tombol Toggle Farm
toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(0.8, 0, 0, 35)
toggleButton.Position = UDim2.new(0.1, 0, 0.2, 0)
toggleButton.BackgroundColor3 = Color3.new(0.2, 0.6, 0.2)
toggleButton.BorderSizePixel = 0
toggleButton.Text = "▶ Start Farm"
toggleButton.TextColor3 = Color3.new(1, 1, 1)
toggleButton.TextScaled = true
toggleButton.Font = Enum.Font.GothamBold
toggleButton.Parent = background

toggleButton.MouseButton1Click:Connect(function()
    if isFarming then
        stopFarming()
    else
        startFarming()
    end
end)

