-- 3. Auto Farm Marshmellow + Safe Zone setelah 1x masak
local autoFarmActive = false

task.spawn(function()
    while true do
        task.wait(1)
        if autoFarmActive then
            pcall(function()
                -- Proses simulasi memasak marshmellow
                local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes", true)
                if remotes then
                    for _, v in pairs(remotes:GetDescendants()) do
                        if v:IsA("RemoteEvent") and (v.Name:lower():find("cook") or v.Name:lower():find("craft")) then
                            v:FireServer("Marshmellow")
                            task.wait(0.5)
                            -- Setiap selesai memasak satu kali, pindah ke safe zone
                            teleportToSafeZone()
                        end
                    end
                end
            end)
        end
    end
end)

