-- Helper function to create toggles
local function createToggle(name, yPos, callback)
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Size = UDim2.new(1, 0, 0, 40)
    ToggleBtn.Position = UDim2.new(0, 0, 0, yPos)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
    ToggleBtn.Font = Enum.Font.GothamSemibold
    ToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 255)
    ToggleBtn.TextSize = 14
    ToggleBtn.Text = name .. ": [ OFF ]"
    ToggleBtn.Parent = ContentFrame

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 8)
    BtnCorner.Parent = ToggleBtn

    local enabled = false
    ToggleBtn.MouseButton1Click:Connect(function()
        enabled = not enabled
        if enabled then
            ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 100)
            ToggleBtn.Text = name .. ": [ ON ]"
        else
            ToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
            ToggleBtn.Text = name .. ": [ OFF ]"
        end
        callback(enabled)
    end)
end

