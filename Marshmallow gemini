-- Safe Zone Position (Sesuaikan jika diperlukan koordinat aslinya di game)
local SafeZonePosition = Vector3.new(0, 50, 0) 

local function teleportToSafeZone()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(SafeZonePosition)
    end
end

-- 1. Auto Spawn Motorcycle (Buya Marshmellow)
local function spawnMotorcycle()
    -- Mengirim event atau mencari fungsi spawn motor di workspace
    pcall(function()
        -- Contoh replika event remote jika game menggunakannya
        local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes", true)
        if remotes then
            -- Cari remote spawn kendaraan
            for _, v in pairs(remotes:GetDescendants()) do
                if v:IsA("RemoteEvent") and (v.Name:lower():find("spawn") or v.Name:lower():find("vehicle") or v.Name:lower():find("bike")) then
                    v:FireServer("MarshmellowBike") -- Menyesuaikan nama kendaraan
                end
            end
        end
    end)
end

