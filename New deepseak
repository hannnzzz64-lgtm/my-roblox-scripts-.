-- 7. CRASH PROTECTION (mencegah crash)
local function crashProtection()
    -- Tangani error agar tidak crash
    xpcall(function()
        while true do
            task.wait(60)
            -- Reset memory leak (jika ada)
            collectgarbage("collect")
        end
    end, function(err)
        print("Crash protection triggered: " .. tostring(err))
    end)
end

-- 8. RANDOM WALK (bukan teleport langsung)
local originalTeleport = Teleport
Teleport = function(pos)
    if not HRP then return end
    
    -- Kalau jarak jauh, jalan bertahap
    local currentPos = HRP.Position
    local distance = (pos.Position - currentPos).Magnitude
    
    if distance > 50 then
        -- Teleport dengan delay (seperti loading)
        local steps = math.min(math.floor(distance / 10), 5)
        for i = 1, steps do
            local lerpPos = HRP.CFrame:lerp(pos, i / steps)
            originalTeleport(lerpPos)
            task.wait(0.1 + math.random() * 0.15)
        end
        originalTeleport(pos)
    else
        originalTeleport(pos)
    end
end

