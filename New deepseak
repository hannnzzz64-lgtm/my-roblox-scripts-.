-- Fungsi Teleport dengan Tween (lebih smooth)
local function Teleport(pos)
    if not HRP then return end
    local tween = TweenService:Create(HRP, TweenInfo.new(0.3, Enum.EasingStyle.Linear), {CFrame = pos})
    tween:Play()
    tween.Completed:Wait()
end

-- Fungsi Fire Proximity Prompt
local function FirePrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") then
        prompt:FireServer()
        return true
    end
    return false
end

-- =============== BOX JOB ===============
local function BoxFarm()
    local positions = {
        CFrame.new(-552.45, 3.54, -83.86),  -- Start Box Job
        CFrame.new(-401.31, 3.41, -72.42),  -- Drop Box
    }
    
    while farming and farmType == "Box" do
        task.wait()
        
        -- Ambil job
        if not LP:GetAttribute("WorkingJob") then
            Teleport(positions[1])
            task.wait(0.3)
            
            local prompt = workspace:FindFirstChild("BoxJob") or workspace:FindFirstChild("StartJob")
            if prompt then
                FirePrompt(prompt)
                task.wait(1)
            end
        end
        
        -- Bawa box ke drop point
        if LP:GetAttribute("WorkingJob") then
            Teleport(positions[2])
            task.wait(0.3)
            
            local dropPrompt = workspace:FindFirstChild("DropBox") or workspace:FindFirstChild("BoxDrop")
            if dropPrompt then
                FirePrompt(dropPrompt)
                task.wait(2)
            end
        end
    end
end

-- =============== CONSTRUCTION JOB ===============
local function ConstructionFarm()
    while farming and farmType == "Construction" do
        task.wait()
        
        -- Start Construction Job
        if not LP:GetAttribute("WorkingJob") then
            Teleport(CFrame.new(-1729, 371, -1171))
            task.wait(0.3)
            
            local startPrompt = workspace:FindFirstChild("ConstructionStuff") and workspace.ConstructionStuff:FindFirstChild("Start Job")
            if startPrompt then
                FirePrompt(startPrompt)
                task.wait(1)
            end
        end
        
        -- Ambil Kayu
        if LP:GetAttribute("WorkingJob") then
            local hasWood = LP.Backpack:FindFirstChild("PlyWood") or LP.Character:FindFirstChild("PlyWood")
            if not hasWood then
                Teleport(CFrame.new(-1728, 371, -1178))
                task.wait(0.3)
                
                local woodPrompt = workspace.ConstructionStuff:FindFirstChild("Grab Wood")
                if woodPrompt then
                    FirePrompt(woodPrompt)
                    task.wait(1)
                end
            end
        end
        
        -- Bangun Tembok
        if LP:GetAttribute("WorkingJob") then
            local wall = workspace.ConstructionStuff:FindFirstChild("Wall")
            if wall then
                Teleport(CFrame.new(wall.Position + Vector3.new(0, 5, 0)))
                task.wait(0.3)
                FirePrompt(wall.Prompt)
                task.wait(2)
            end
        end
    end
end

-- =============== MAIN FARM LOOP ===============
local function StartFarm()
    if isRunning then return end
    isRunning = true
    farming = true
    
    while farming do
        task.wait(0.5)
        
        if farmType == "Box" then
            BoxFarm()
        elseif farmType == "Construction" then
            ConstructionFarm()
        end
        
        -- Jika mati/respawn, tunggu
        if not LP.Character or LP.Character:FindFirstChild("Humanoid") == nil then
            repeat task.wait(1) until LP.Character and LP.Character:FindFirstChild("Humanoid")
            Character = LP.Character
            HRP = Character:WaitForChild("HumanoidRootPart")
            Humanoid = Character:WaitForChild("Humanoid")
        end
    end
    
    isRunning = false
end

local function StopFarm()
    farming = false
    isRunning = false
end

