-- Fungsi Spawn Motor
local function SpawnMotor()
    local args = {
        [1] = "SpawnVehicle",
        [2] = "Motor"
    }
    local remote = game:GetService("ReplicatedStorage"):FindFirstChild("VehicleRemote")
    if remote then
        remote:FireServer(unpack(args))
        game:GetService("StarlightGui"):SetCore("SendNotification", {
            Title = "Motor",
            Text = "Motor berhasil di-spawn!"
        })
    else
        -- Coba cari remote lain
        for _, obj in pairs(game:GetService("ReplicatedStorage"):GetChildren()) do
            if obj:IsA("RemoteEvent") and obj.Name:find("Vehicle") then
                obj:FireServer("SpawnVehicle", "Motor")
                break
            end
        end
    end
end

-- Fungsi Anti AFK / Bypass
local function StartBypass()
    BypassActive = true
    if BypassConnection then BypassConnection:Disconnect() end
    
    BypassConnection = RunService.Heartbeat:Connect(function()
        if not BypassActive then 
            BypassConnection:Disconnect()
            return 
        end
        -- Simulasi gerakan
        local VirtualUser = game:GetService("VirtualUser")
        if VirtualUser then
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        end
        -- Kirim input kosong
        if Character and Character:FindFirstChild("Humanoid") then
            Character.Humanoid.MoveDirection = Vector3.new(0, 0, 1)
            wait(0.1)
            Character.Humanoid.MoveDirection = Vector3.new(0, 0, 0)
        end
    end)
end

-- Fungsi Auto Sell
local function AutoSell()
    local inventory = Player:FindFirstChild("Inventory")
    if inventory then
        for _, item in pairs(inventory:GetChildren()) do
            if item:IsA("Tool") and (item.Name:find("Marshmallow") or item.Name:find("Cooked")) then
                local sellRemote = game:GetService("ReplicatedStorage"):FindFirstChild("SellItem")
                if sellRemote then
                    sellRemote:FireServer(item)
                    wait(0.5)
                else
                    -- Coba cari remote sell lain
                    for _, obj in pairs(game:GetService("ReplicatedStorage"):GetChildren()) do
                        if obj:IsA("RemoteEvent") and obj.Name:find("Sell") then
                            obj:FireServer(item)
                            break
                        end
                    end
                end
            end
        end
    end
end

-- Fungsi Auto Buy Marshmallow
local function AutoBuy()
    local shopRemote = game:GetService("ReplicatedStorage"):FindFirstChild("ShopRemote")
    if shopRemote then
        shopRemote:FireServer("Marshmallow", 1)
    else
        -- Coba cari remote shop lain
        for _, obj in pairs(game:GetService("ReplicatedStorage"):GetChildren()) do
            if obj:IsA("RemoteEvent") and (obj.Name:find("Shop") or obj.Name:find("Buy")) then
                obj:FireServer("Marshmallow", 1)
                break
            end
        end
    end
end

-- Fungsi Auto Farm utama
local function StartFarming()
    if FarmRunning then return end
    FarmRunning = true
    
    -- Aktifkan bypass otomatis
    if not BypassActive then
        StartBypass()
    end
    
    FarmConnection = RunService.Heartbeat:Connect(function()
        if not FarmRunning then
            FarmConnection:Disconnect()
            return
        end
        
        -- Cari Safe Zone
        local SafeZone = Workspace:FindFirstChild("SafeZone") or Workspace:FindFirstChild("SafeZone_Trenches")
        if SafeZone then
            -- Cari cooking station
            local cookingStations = SafeZone:FindFirstChild("CookingStations")
            if cookingStations then
                local nearestStation = nil
                local shortestDist = math.huge
                for _, station in pairs(cookingStations:GetChildren()) do
                    if station:IsA("Model") and station:FindFirstChild("ProximityPrompt") then
                        local stationPart = station:FindFirstChild("Part") or station:FindFirstChild("Handle") or station.PrimaryPart
                        if stationPart then
                            local dist = (Character.HumanoidRootPart.Position - stationPart.Position).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                nearestStation = station
                            end
                        end
                    end
                end
                
                if nearestStation then
                    local stationPart = nearestStation:FindFirstChild("Part") or nearestStation:FindFirstChild("Handle") or nearestStation.PrimaryPart
                    if stationPart then
                        -- Teleport ke station
                        Character.HumanoidRootPart.CFrame = stationPart.CFrame + Vector3.new(0, 2, 0)
                        wait(1)
                        
                        -- Interact
                        local prompt = nearestStation:FindFirstChild("ProximityPrompt")
                        if prompt then
                            prompt:InputHoldBegin(Character)
                            wait(2)
                            prompt:InputHoldEnd(Character)
                            
                            -- Tunggu masak
                            wait(4)
                            
                            -- Auto sell & buy
                            AutoSell()
                            AutoBuy()
                        end
                    end
                end
            end
        end
    end)
end

-- Fungsi Stop Farming
local function StopFarming()
    FarmRunning = false
    if FarmConnection then
        FarmConnection:Disconnect()
        FarmConnection = nil
    end
end

