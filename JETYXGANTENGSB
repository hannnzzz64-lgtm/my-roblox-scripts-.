-- Fungsi untuk membuat Button
local function CreateButton(parent, text, color, callback, order)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.BackgroundColor3 = color or Color3.fromRGB(0, 80, 200)
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.Position = UDim2.new(0, 5, 0, 0)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.Font = Enum.Font.Gotham
    btn.BorderSizePixel = 1
    btn.BorderColor3 = Color3.fromRGB(100, 150, 255)
    btn.MouseButton1Click:Connect(callback)
    btn.LayoutOrder = order or 0
    return btn
end

-- Fungsi untuk membuat Label
local function CreateLabel(parent, text, order)
