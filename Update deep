-- ============================================
-- ============ SAFE MODE CONFIG ============
-- ============================================

-- Konfigurasi delay (semakin besar = semakin aman)
local CONFIG = {
    MIN_DELAY = 0.5,      -- Delay minimum (detik)
    MAX_DELAY = 2.0,      -- Delay maksimum (detik)
    TELEPORT_DELAY = 0.3, -- Delay antar teleport
    WALK_SPEED = 16,      -- Kecepatan jalan normal
    HUMAN_DELAY = true,   -- Aktifkan delay random seperti manusia
}

-- Fungsi delay random (seperti manusia berpikir)
local function humanDelay()
    if not CONFIG.HUMAN_DELAY then return end
    local delay = CONFIG.MIN_DELAY + math.random() * (CONFIG.MAX_DELAY - CONFIG.MIN_DELAY)
    task.wait(delay)
end

-- Fungsi delay pendek (untuk aksi cepat)
local function shortDelay()
    task.wait(0.3 + math.random() * 0.5)
end

-- Fungsi delay medium (untuk antar job)
local function mediumDelay()
    task.wait(0.8 + math.random() * 1.2)
end

-- Fungsi delay panjang (seperti istirahat)
local function longDelay()
    task.wait(2.0 + math.random() * 3.0)
end

-- Fungsi "berpikir" sebelum action (seperti manusia)
local function thinkBeforeAction()
    task.wait(0.5 + math.random() * 1.5)
end

-- ============================================
-- ============ MODIFIKASI FUNGSI ============
-- ============================================

-- OVERRIDE Teleport dengan delay lebih lambat
local originalTeleport = Teleport
Teleport = function(pos)
    if not HRP then return end
    
    -- Delay sebelum teleport (seperti manusia memutuskan)
    thinkBeforeAction()
    
    local currentPos = HRP.Position
    local distance = (pos.Position - currentPos).Magnitude
    
    if distance > 30 then
        -- Jalan bertahap dengan delay lebih lama
        local steps = math.min(math.floor(distance / 8), 8)
        for i = 1, steps do
            local lerpPos = HRP.CFrame:lerp(pos, i / steps)
            originalTeleport(lerpPos)
            task.wait(0.3 + math.random() * 0.3) -- Delay lebih lama
        end
        originalTeleport(pos)
        task.wait(0.2 + math.random() * 0.3)
    else
        originalTeleport(pos)
        task.wait(0.2 + math.random() * 0.2)
    end
end

-- OVERRIDE FirePrompt dengan delay lebih lambat
local originalFirePrompt = FirePrompt
FirePrompt = function(prompt)
    if prompt and prompt:IsA("ProximityPrompt") then
        -- Delay sebelum interaksi (seperti manusia mendekat)
        task.wait(0.3 + math.random() * 0.7)
        prompt:FireServer()
        task.wait(0.5 + math.random() * 0.5) -- Delay setelah interaksi
        return true
    end
    return false
end
```

