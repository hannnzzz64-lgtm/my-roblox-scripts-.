local function Teleport(pos)
    if not HRP then return end
    thinkDelay()
    
    local distance = (pos.Position - HRP.Position).Magnitude
    if distance > 30 then
        local steps = math.min(math.floor(distance / 8), 8)
        for i = 1, steps do
            local lerpPos = HRP.CFrame:lerp(pos, i / steps)
            local tween = TweenService:Create(HRP, 
                TweenInfo.new(0.5 + math.random() * 0.3, Enum.EasingStyle.Linear), 
                {CFrame = lerpPos}
            )
            tween:Play()
            tween.Completed:Wait()
            task.wait(0.2 + math.random() * 0.3)
        end
    end
    
    local tween = TweenService:Create(HRP, 
        TweenInfo.new(0.3 + math.random() * 0.2, Enum.EasingStyle.Linear), 
        {CFrame = pos}
    )
    tween:Play()
    tween.Completed:Wait()
    task.wait(0.2 + math.random() * 0.3)
end

local function FirePrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") then
        task.wait(0.5 + math.random() * 1.0)
        prompt:FireServer()
        task.wait(0.5 + math.random() * 0.5)
        return true
    end
    return false
