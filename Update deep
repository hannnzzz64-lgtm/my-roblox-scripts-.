-- ============ MAIN FARM ============
-- ============================================

local function StartFarm()
    if isRunning then return end
    isRunning = true
    farming = true
    
    if CONFIG.AUTO_BREAK then
        autoBreakSystem()
    end
    
    while farming do
        task.wait(0.5)
        
        if farmType == "Box" then
            BoxFarm()
        elseif farmType == "Construction" then
            ConstructionFarm()
        end
        
        if not LP.Character or not LP.Character:FindFirstChild("Humanoid") then
            repeat task.wait(2) until LP.Character and LP.Character:FindFirstChild("Humanoid")
            Character = LP.Character
            HRP = Character:WaitForChild("HumanoidRootPart")
            Humanoid = Character:WaitForChild("Humanoid")
        end
    end
    
    isRunning = false
end

local function StopFarm()
    farming = false
    isRunning = false
    breakActive = false
end

