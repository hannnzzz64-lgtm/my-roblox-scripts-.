-- ============================================
-- ============ AUTO BREAK SYSTEM ============
-- ============================================

local autoBreak = false
local breakDuration = 60 -- Istirahat 60 detik
local farmDuration = 180 -- Farm 3 menit
local farmStartTime = 0

-- Fungsi auto break (istirahat otomatis)
local function startAutoBreak()
    spawn(function()
        while farming do
            -- Farm selama farmDuration detik
            task.wait(farmDuration)
            
            if farming then
                print("⏸️ Auto break: Istirahat " .. breakDuration .. " detik...")
                farming = false -- Berhenti sementara
                
                -- Update UI
                StatusLabel.Text = "⏸️ BREAK " .. breakDuration .. "s"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
                ControlBtn.Text = "⏸ BREAK"
                ControlBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
                
                -- Istirahat
                task.wait(breakDuration)
                
                if isRunning then
                    print("▶️ Resume farming...")
                    farming = true
                    StatusLabel.Text = "▶ FARMING: " .. farmType
                    StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                    ControlBtn.Text = "⏹ STOP"
                    ControlBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
                end
            end
        end
    end)
end

-- Toggle auto break di UI (opsional)
