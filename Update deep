```lua
-- =============== BOX JOB (LAMBAT) ===============
local function BoxFarm()
    local positions = {
        CFrame.new(-552.45, 3.54, -83.86),
        CFrame.new(-401.31, 3.41, -72.42),
    }
    
    while farming and farmType == "Box" do
        task.wait()
        
        -- Cek apakah sedang bekerja
        if not LP:GetAttribute("WorkingJob") then
            -- Delay sebelum mulai (seperti manusia bersiap)
            humanDelay()
            
            Teleport(positions[1])
            shortDelay()
            
            local prompt = workspace:FindFirstChild("BoxJob") or workspace:FindFirstChild("StartJob")
            if prompt then
                FirePrompt(prompt)
                mediumDelay() -- Tunggu sebentar
            end
        end
        
        -- Bawa box ke drop point
        if LP:GetAttribute("WorkingJob") then
            -- Delay sebelum pindah (seperti manusia mengangkat box)
            mediumDelay()
            
            Teleport(positions[2])
            shortDelay()
            
            local dropPrompt = workspace:FindFirstChild("DropBox") or workspace:FindFirstChild("BoxDrop")
            if dropPrompt then
                FirePrompt(dropPrompt)
                longDelay() -- Tunggu lebih lama setelah drop
            end
        end
        
        -- Random pause di antara cycle (seperti manusia istirahat)
        if math.random() < 0.15 then -- 15% chance
            humanDelay()
        end
    end
end
