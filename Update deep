local function autoBreakSystem()
    spawn(function()
        while true do
            task.wait(CONFIG.BREAK_INTERVAL)
            if farming and CONFIG.AUTO_BREAK then
                print("⏸️ Auto break: Istirahat " .. CONFIG.BREAK_DURATION .. " detik...")
                farming = false
                breakActive = true
                
                if StatusLabel then
                    StatusLabel.Text = "⏸️ BREAK " .. CONFIG.BREAK_DURATION .. "s"
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
