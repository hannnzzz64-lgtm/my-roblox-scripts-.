-- Toggle UI Animation Helper
local function toggleState(btn, circle, state)
	if state then
		game:GetService("TweenService"):Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 200, 120)}):Play()
		game:GetService("TweenService"):Create(circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 18, 0, 2)}):Play()
	else
		game:GetService("TweenService"):Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(180, 180, 180)}):Play()
		game:GetService("TweenService"):Create(circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0, 2)}):Play()
	end
end

-- 1. Anti-Lag Logic
local antiLagActive = false
AntiLagToggleBg.MouseButton1Click:Connect(function()
	antiLagActive = not antiLagActive
	toggleState(AntiLagToggleBg, AntiLagToggleCircle, antiLagActive)
	
	if antiLagActive then
		Lighting.GlobalShadows = false
		Lighting.Brightness = 1.2
		Lighting.ClockTime = 0 
		Lighting.OutdoorAmbient = Color3.fromRGB(80, 80, 80)
		Lighting.Ambient = Color3.fromRGB(60, 60, 60)
		
		for _, v in pairs(Lighting:GetChildren()) do
			if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") or v:IsA("Clouds") then
				v:Destroy()
			end
		end

		for _, v in pairs(Workspace:GetDescendants()) do
			if v:IsA("BasePart") then
				v.CastShadow = false
				v.Material = Enum.Material.SmoothPlastic
				v.Color = Color3.fromRGB(100, 100, 100)
				
				for _, child in pairs(v:GetChildren()) do
					if child:IsA("Texture") or child:IsA("Decal") then
						child:Destroy()
					end
				end
			elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
				v.Enabled = false
			end
		end
	else
		Lighting.GlobalShadows = true
		Lighting.Brightness = 2
		Lighting.ClockTime = 14
		Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
		Lighting.Ambient = Color3.fromRGB(128, 128, 128)
	end
end)

