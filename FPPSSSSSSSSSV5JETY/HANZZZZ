RunService.RenderStepped:Connect(function()
	local hueTime = (tick() % 5) / 5
	local rainbowColor = Color3.fromHSV(hueTime, 1, 1)
	
	MainStroke.Color = rainbowColor
	ConfigStroke.Color = rainbowColor
end)

local function toggleState(btn, circle, state)
	if state then
		TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 200, 120)}):Play()
		TweenService:Create(circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 18, 0, 2)}):Play()
	else
		TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(180, 180, 180)}):Play()
		TweenService:Create(circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0, 2)}):Play()
	end
end

local antiLagActive = false
local remAccActive = false
local remClotActive = false
local fpsActive = false
local stretchActive = false
local customNameActive = false
local rainbowNameActive = false

local currentHue = 0
local currentSat = 1
local currentVal = 1
local selectedColor = Color3.fromRGB(255, 255, 255)

local function updateColorPicker()
	selectedColor = Color3.fromHSV(currentHue, currentSat, currentVal)
	SatValBox.BackgroundColor3 = Color3.fromHSV(currentHue, 1, 1)
end

local draggingHue = false
local draggingSatVal = false

HueSlider.MouseButton1Down:Connect(function() draggingHue = true end)
SatValBox.MouseButton1Down:Connect(function() draggingSatVal = true end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingHue = false
		draggingSatVal = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		local mousePos = UserInputService:GetMouseLocation()
		
		if draggingHue then
			local absPos = HueSlider.AbsolutePosition
			local absSize = HueSlider.AbsoluteSize
			local relativeY = math.clamp((mousePos.Y - absPos.Y) / absSize.Y, 0, 1)
			currentHue = relativeY
			HueSelector.Position = UDim2.new(0, -2, relativeY, -2)
			updateColorPicker()
		elseif draggingSatVal then
			local absPos = SatValBox.AbsolutePosition
			local absSize = SatValBox.AbsoluteSize
			local relativeX = math.clamp((mousePos.X - absPos.X) / absSize.X, 0, 1)
			local relativeY = math.clamp((mousePos.Y - absPos.Y) / absSize.Y, 0, 1)
			
			currentSat = relativeX
			currentVal = 1 - relativeY
			
			SatValSelector.Position = UDim2.new(relativeX, -4, relativeY, -4)
			updateColorPicker()
		end
	end
end)

-- 1. Anti-Lag Logic
AntiLagToggleBg.MouseButton1Click:Connect(function()
	antiLagActive = not antiLagActive
	toggleState(AntiLagToggleBg, AntiLagToggleCircle, antiLagActive)
	
	if antiLagActive then
		Lighting.GlobalShadows = false
		Lighting.Brightness = 0.5
		Lighting.ClockTime = 22
		Lighting.OutdoorAmbient = Color3.fromRGB(80, 80, 80)
		Lighting.Ambient = Color3.fromRGB(70, 70, 70)
		
		for _, v in pairs(Lighting:GetChildren()) do
			if v:IsA("PostEffect") or v:IsA("Atmosphere") then
				v:Destroy()
			end
		end

		for _, v in pairs(Workspace:GetDescendants()) do
			if v:IsA("BasePart") then
				v.CastShadow = false
				v.Material = Enum.Material.SmoothPlastic
				for _, child in pairs(v:GetChildren()) do
					if child:IsA("ParticleEmitter") or child:IsA("Trail") or child:IsA("Fire") or child:IsA("Smoke") or child:IsA("Sparkles") then
						child.Enabled = false
					end
				end
			elseif v:IsA("Decal") or v:IsA("Texture") then
				v:Destroy()
			end
		end
	else
		Lighting.GlobalShadows = true
		Lighting.Brightness = 2
		Lighting.ClockTime = 14
		Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
		Lighting.Ambient = Color3.fromRGB(128, 128, 128)
	end
end)

