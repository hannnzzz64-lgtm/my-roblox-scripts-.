local lastUpdate = tick()
local frameCount = 0

RunService.RenderStepped:Connect(function()
	if fpsActive then
		local hue = (tick() % 5) / 5
		fpsLabel.TextColor3 = Color3.fromHSV(hue, 1, 1)

		frameCount = frameCount + 1
		local now = tick()
		if now - lastUpdate >= 1 then
            fpsLabel.Text = "FPS: " .. math.floor(frameCount / (now - lastUpdate))
            frameCount = 0
            lastUpdate = now
		end
	end
	
	-- Update custom name color & text dynamically if active
	local char = LocalPlayer.Character
	local head = char and char:FindFirstChild("Head")
	if head then
		local tag = head:FindFirstChild("HnxCustomNameTag")
		if tag then
			local textLbl = tag:FindFirstChild("CustomNameText")
			if textLbl then
				if rainbowNameActive then
					local hue = (tick() % 5) / 5
					textLbl.TextColor3 = Color3.fromHSV(hue, 1, 1)
				else
					textLbl.TextColor3 = selectedColor
				end
			end
		end
	end
end)

