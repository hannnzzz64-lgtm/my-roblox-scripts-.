-- 6. Custom Name Tag & Rainbow Text Logic
local function setupCustomName(char)
	if not customNameActive or not char then return end
	
	local head = char:WaitForChild("Head", 5)
	local humanoid = char:WaitForChild("Humanoid", 5)
	
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	
	for _, child in pairs(head:GetChildren()) do
		if child:IsA("BillboardGui") and child.Name ~= "HnxCustomNameTag" then
			child.Enabled = false
		end
	end
	
	if head and not head:FindFirstChild("HnxCustomNameTag") then
		local bb = Instance.new("BillboardGui")
		bb.Name = "HnxCustomNameTag"
		bb.Size = UDim2.new(0, 200, 0, 50)
		bb.StudsOffset = Vector3.new(0, 2.0, 0)
		bb.AlwaysOnTop = true
		bb.Parent = head
		
		local textLbl = Instance.new("TextLabel")
		textLbl.Name = "CustomNameText"
		textLbl.Size = UDim2.new(1, 0, 1, 0)
		textLbl.BackgroundTransparency = 1
		textLbl.Font = Enum.Font.SourceSansBold
		textLbl.Text = CustomNameBox.Text ~= "" and CustomNameBox.Text or "Custom Name"
		textLbl.TextSize = 20
		textLbl.TextStrokeTransparency = 0
		textLbl.TextColor3 = selectedColor
		textLbl.Parent = bb
	end
end

customNameBtn.MouseButton1Click:Connect(function()
	customNameActive = not customNameActive
	toggleState(customNameBtn, customNameCir, customNameActive)
	
	local char = LocalPlayer.Character
	local head = char and char:FindFirstChild("Head")
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	
	if customNameActive then
		setupCustomName(char)
	else
		if humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		end

		if head then
			local tag = head:FindFirstChild("HnxCustomNameTag")
			if tag then tag:Destroy() end
			
			for _, child in pairs(head:GetChildren()) do
				if child:IsA("BillboardGui") and child.Name ~= "HnxCustomNameTag" then
					child.Enabled = true
				end
			end
		end
	end
end)

