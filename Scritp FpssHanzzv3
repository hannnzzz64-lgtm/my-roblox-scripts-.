-- 2. Remover Acessórios
remAccBtn.MouseButton1Click:Connect(function()
	remAccActive = not remAccActive
	toggleState(remAccBtn, remAccCir, remAccActive)
	
	if remAccActive then
		for _, char in pairs(Workspace:GetChildren()) do
			if char:FindFirstChildOfClass("Humanoid") then
				for _, v in pairs(char:GetChildren()) do
					if v:IsA("Accessory") then
						v:Destroy()
					end
				end
			end
		end
	end
end)

-- 3. Remover Roupas
remClotBtn.MouseButton1Click:Connect(function()
    remClotActive = not remClotActive
    toggleState(remClotBtn, remClotCir, remClotActive)
    
    if remClotActive then
        for _, char in pairs(Workspace:GetChildren()) do
            if char:FindFirstChildOfClass("Humanoid") then
                for _, v in pairs(char:GetChildren()) do
                    if v:IsA("Clothing") or v:IsA("ShirtGraphic") then
                        v:Destroy()
                    end
                end
            end
        end
    end
end)

-- 4. Contador de FPS (Rainbow/Pelangi Effect)
local fpsLabel = Instance.new("TextLabel")
fpsLabel.Size = UDim2.new(0, 120, 0, 30)
fpsLabel.Position = UDim2.new(0, 10, 0, 10)
fpsLabel.BackgroundTransparency = 1
fpsLabel.Font = Enum.Font.SourceSansBold
fpsLabel.TextSize = 18
fpsLabel.Visible = false
fpsLabel.Parent = ScreenGui

local lastUpdate = tick()
local frameCount = 0

RunService.RenderStepped:Connect(function()
	if fpsActive then
		local hue = (tick() % 5) / 5
		fpsLabel.TextColor3 = Color3.fromHSV(hue, 1, 1)

		frameCount = frameCount + 1
		local now = tick()
		if now - lastUpdate >= 1 then
			fpsLabel.Text = "FPS: " .. math.floor(frameCount / (now - lastUpdate))
			frameCount = 0
			lastUpdate = now
		end
	end
end)

fpsBtn.MouseButton1Click:Connect(function()
	fpsActive = not fpsActive
	toggleState(fpsBtn, fpsCir, fpsActive)
	fpsLabel.Visible = fpsActive
end)

