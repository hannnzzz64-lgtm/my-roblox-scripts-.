-- 6. Rainbow Name (Otomatis Aktif Rainbow Karakter Utama & Sembunyikan Username Tengah)
local customBillboardName = nil

local function setupRainbowName(char)
	if not rainbowNameActive or not char then return end
	
	local head = char:WaitForChild("Head", 5)
	local humanoid = char:WaitForChild("Humanoid", 5)
	
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	
	if head and not head:FindFirstChild("RainbowNameTag") then
		local bb = Instance.new("BillboardGui")
		bb.Name = "RainbowNameTag"
		bb.Size = UDim2.new(0, 200, 0, 50)
		bb.StudsOffset = Vector3.new(0, 2.5, 0)
		bb.AlwaysOnTop = true
		bb.Parent = head
		
		local textLbl = Instance.new("TextLabel")
		textLbl.Name = "NameText"
		textLbl.Size = UDim2.new(1, 0, 1, 0)
		textLbl.BackgroundTransparency = 1
		textLbl.Font = Enum.Font.SourceSansBold
		textLbl.Text = LocalPlayer.Name
		textLbl.TextSize = 20
		textLbl.Parent = bb
		
		customBillboardName = textLbl
	end
end

-- Langsung aktifkan Rainbow Name saat pertama kali script dijalankan
rainbowNameActive = true
toggleState(rainbowNameBtn, rainbowNameCir, true)
if LocalPlayer.Character then
	setupRainbowName(LocalPlayer.Character)
end

rainbowNameBtn.MouseButton1Click:Connect(function()
	rainbowNameActive = not rainbowNameActive
	toggleState(rainbowNameBtn, rainbowNameCir, rainbowNameActive)
	
	local char = LocalPlayer.Character
	local head = char and char:FindFirstChild("Head")
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	
	if rainbowNameActive then
		setupRainbowName(char)
	else
		if humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		end

		if head then
			local tag = head:FindFirstChild("RainbowNameTag")
			if tag then tag:Destroy() end
		end
		customBillboardName = nil
	end
end)

-- Auto re-apply saat karakter respawn
LocalPlayer.CharacterAdded:Connect(function(newChar)
	if rainbowNameActive then
		task.wait(0.5)
		setupRainbowName(newChar)
	end
end)

-- Loop update warna teks nama di atas kepala karakter & handle pointer
RunService.RenderStepped:Connect(function()
	if rainbowNameActive then
		local char = LocalPlayer.Character
		local head = char and char:FindFirstChild("Head")
		if head then
			local tag = head:FindFirstChild("RainbowNameTag")
			if tag then
				local textLbl = tag:FindFirstChild("NameText")
				if textLbl then
					customBillboardName = textLbl
					local hue = (tick() % 5) / 5
					textLbl.TextColor3 = Color3.fromHSV(hue, 1, 1)
				end
			end
		end
	end
end)


-- // CONFIG SYSTEM LOGIC & CUSTOM NAME \\ --
local SavedConfigs = {}

local function setFeatureState(featureName, targetState)
	if featureName == "AntiLag" and antiLagActive ~= targetState then
		AntiLagToggleBg.MouseButton1Click:Fire()
	elseif featureName == "RemAcc" and remAccActive ~= targetState then
		remAccBtn.MouseButton1Click:Fire()
	elseif featureName == "RemClot" and remClotActive ~= targetState then
		remClotBtn.MouseButton1Click:Fire()
	elseif featureName == "FPS" and fpsActive ~= targetState then
		fpsBtn.MouseButton1Click:Fire()
	elseif featureName == "Stretch" and stretchActive ~= targetState then
		stretchBtn.MouseButton1Click:Fire()
	elseif featureName == "RainbowName" and rainbowNameActive ~= targetState then
		rainbowNameBtn.MouseButton1Click:Fire()
	end
end

CreateConfigBtn.MouseButton1Click:Connect(function()
	local configName = ConfigNameBox.Text
	if configName == "" or configName == "Ketik nama config..." then
		StatusLabel.TextColor3 = Color3.fromRGB(200, 50, 50)
		StatusLabel.Text = "Gagal: Masukkan nama custom!"
		return
	end
	
	SavedConfigs[configName] = {
		AntiLag = antiLagActive,
		RemAcc = remAccActive,
		RemClot = remClotActive,
		FPS = fpsActive,
		Stretch = stretchActive,
		RainbowName = rainbowNameActive
	}
	
	StatusLabel.TextColor3 = Color3.fromRGB(50, 150, 50)
	StatusLabel.Text = "Sukses: Config '" .. configName .. "' dibuat!"
end)

LoadConfigBtn.MouseButton1Click:Connect(function()
	local configName = ConfigNameBox.Text
	if SavedConfigs[configName] then
		local cfg = SavedConfigs[configName]
		
		setFeatureState("AntiLag", cfg.AntiLag)
		setFeatureState("RemAcc", cfg.RemAcc)
		setFeatureState("RemClot", cfg.RemClot)
		setFeatureState("FPS", cfg.FPS)
		setFeatureState("Stretch", cfg.Stretch)
		setFeatureState("RainbowName", cfg.RainbowName)
		
		StatusLabel.TextColor3 = Color3.fromRGB(50, 100, 200)
		StatusLabel.Text = "Sukses: Config '" .. configName .. "' dimuat!"
	else
		StatusLabel.TextColor3 = Color3.fromRGB(200, 50, 50)
		StatusLabel.Text = "Gagal: Nama config tidak ditemukan!"
	end
end)
