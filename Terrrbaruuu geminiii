-- // Optimized Auto Farm Logic (Using task.spawn and intervals to prevent lag)
local AutoFarmRunning = false

local function getMarshmallow()
    for _, obj in ipairs(Workspace:GetChildren()) do -- Diubah ke GetChildren atau batasi pencarian agar ringan
        if obj.Name:lower():find("marshmallow") and obj:IsA("BasePart") then
            return obj
        end
    end
    -- Fallback jika ada di dalam folder tertentu
    for _, folder in ipairs(Workspace:GetChildren()) do
        if folder:IsA("Folder") or folder:IsA("Model") then
            for _, obj in ipairs(folder:GetChildren()) do
                if obj.Name:lower():find("marshmallow") and obj:IsA("BasePart") then
                    return obj
                end
            end
        end
    end
    return nil
end

ToggleButton.MouseButton1Click:Connect(function()
    AutoFarmRunning = not AutoFarmRunning
    if AutoFarmRunning then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 140, 70)
        StatusLabel.Text = "Status: Farming (Optimized)..."
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(30, 80, 45)
        StatusLabel.Text = "Status: Paused"
    end
end)

-- Mengganti RenderStepped dengan task.spawn + task.wait(0.5) agar tidak membebani FPS game
task.spawn(function()
    while true do
        if AutoFarmRunning then
            pcall(function()
                local marshmallow = getMarshmallow()
                if marshmallow and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = marshmallow.CFrame + Vector3.new(0, 3, 0)
                    
                    if firetouchinterest then
                        firetouchinterest(LocalPlayer.Character.HumanoidRootPart, marshmallow, 0)
                        task.wait(0.05)
                        firetouchinterest(LocalPlayer.Character.HumanoidRootPart, marshmallow, 1)
                    end
                end
            end)
        end
        task.wait(0.5) -- Jeda 0.5 detik per siklus, membuat game tetap mulus tanpa lag/patah-patah
    end
end)
