            Settings.ESPEnabled = state
            if not state then ClearESP() end
        elseif flag == "ESPPlayers" then
            Settings.ESPPlayers = state
        elseif flag == "ESPMobs" then
            Settings.ESPMobs = state
        end
    end)
    
    return btn
end

