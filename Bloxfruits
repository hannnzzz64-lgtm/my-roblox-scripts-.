-- ====== ESP SYSTEM ======
local ESPObjects = {}
local ESPLines = {}

local function CreateESP(object, color, text)
    -- Box ESP
    local box = Instance.new("BoxHandleAdornment")
    box.Size = Vector3.new(4, 5, 4)
    box.AlwaysOnTop = true
    box.ZIndex = 10
    box.Color3 = color or Settings.ESPColor
    box.Transparency = 0.5
    box.Parent = object
    ESPObjects[object] = box
    
    -- Garis dari player ke target
    local line = Instance.new("LineHandleAdornment")
    line.AlwaysOnTop = true
    line.ZIndex = 5
    line.Color3 = color or Settings.ESPColor
    line.Transparency = 0.3
    line.Thickness = 1
    line.Parent = object
    ESPLines[object] = line
    
    -- Nama target
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 100, 0, 30)
    billboard.Adornee = object
    billboard.AlwaysOnTop = true
    billboard.Parent = object
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = text or "Target"
    nameLabel.TextColor3 = color or Settings.ESPColor
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextStrokeTransparency = 0.5
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.Parent = billboard
    ESPObjects[object .. "_name"] = billboard
    
    return {box = box, line = line, billboard = billboard}
end

local function RemoveESP(object)
    if ESPObjects[object] then
        ESPObjects[object]:Destroy()
        ESPObjects[object] = nil
    end
    if ESPObjects[object .. "_name"] then
        ESPObjects[object .. "_name"]:Destroy()
        ESPObjects[object .. "_name"] = nil
    end
    if ESPLines[object] then
        ESPLines[object]:Destroy()
        ESPLines[object] = nil
    end
end

local function ClearESP()
    for obj, esp in pairs(ESPObjects) do
        pcall(function() esp:Destroy() end)
    end
    for obj, line in pairs(ESPLines) do
        pcall(function() line:Destroy() end)
    end
    ESPObjects = {}
    ESPLines = {}
end

local function UpdateESP()
    if not Settings.ESPEnabled then
        ClearESP()
        return
    end
    
    -- ESP untuk Player
    if Settings.ESPPlayers then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= Player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local char = player.Character
                if not ESPObjects[char] then
                    local color = player.TeamColor and player.TeamColor.Color or Settings.ESPColor
                    local text = player.Name .. " [" .. math.floor(char.Humanoid.Health) .. " HP]"
                    CreateESP(char, color, text)
                end
            end
        end
    end
    
    -- ESP untuk Mobs
    if Settings.ESPMobs then
        for _, obj in pairs(Workspace:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                if not Players:GetPlayerFromCharacter(obj) and obj.Humanoid.Health > 0 then
                    if not ESPObjects[obj] then
                        local color = Settings.ESPColor
                        local level = obj:FindFirstChild("Level") and obj.Level.Value or "?"
                        local text = obj.Name .. " [Lv." .. tostring(level) .. "]"
                        CreateESP(obj, color, text)
                    end
                end
            end
        end
    end
    
    -- Update line positions
    for obj, line in pairs(ESPLines) do
        if obj and obj:FindFirstChild("HumanoidRootPart") then
            line.Points = {RootPart.Position, obj.HumanoidRootPart.Position}
        end
    end
end

-- ====== AUTO SEA BEAST ======
local function FindSeaBeast()
    for _, v in pairs(Workspace:GetChildren()) do
        if v:IsA("Model") and v.Name:find("SeaBeast") or v.Name:find("Sea Beast") then
            if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                return v
            end
        end
    end
    return nil
end

local function AttackSeaBeast(beast)
    if not beast or not beast:FindFirstChild("HumanoidRootPart") then return end
    
    -- Cari boat atau platform untuk berdiri
    local boat = nil
    for _, v in pairs(Workspace:GetChildren()) do
        if v:IsA("Model") and (v.Name:find("Boat") or v.Name:find("Ship")) then
            if v:FindFirstChild("HumanoidRootPart") then
                boat = v
                break
            end
        end
    end
    
    -- Jika tidak ada boat, teleport ke atas air
    if not boat then
        local waterPos = beast.HumanoidRootPart.Position + Vector3.new(0, 10, 0)
        RootPart.CFrame = CFrame.new(waterPos)
        task.wait(0.5)
    end
    
    -- Serang Sea Beast
    local hrp = beast.HumanoidRootPart
    RootPart.CFrame = CFrame.new(RootPart.Position, hrp.Position)
    
    -- Gunakan skill/attack
    game:GetService("VirtualUser"):CaptureController()
    game:GetService("VirtualUser"):ClickButton2(Vector2.new())
    
    -- Gunakan skill jika ada
    for _, tool in pairs(Character:GetChildren()) do
        if tool:IsA("Tool") and tool:FindFirstChild("RemoteEvent") then
            tool.RemoteEvent:FireServer()
        end
    end
end

local function SeaBeastLoop()
    while task.wait(0.5) do
        if not Settings.AutoSeaBeast then continue end
        
        local beast = FindSeaBeast()
        if beast then
            AttackSeaBeast(beast)
        else
            -- Cari Sea Beast dengan scanning area
            local scanArea = 500
            for i = 1, 10 do
                local randomPos = Vector3.new(
                    math.random(-scanArea, scanArea),
                    0,
                    math.random(-scanArea, scanArea)
                )
                RootPart.CFrame = CFrame.new(randomPos + Vector3.new(0, 5, 0))
                task.wait(1)
                
                beast = FindSeaBeast()
                if beast then break end
            end
        end
    end
end

-- ====== FUNGSI UTAMA ======
local function FindNearestMob()
    local nearest = nil
    local minDist = math.huge
    
    for _, v in pairs(Workspace:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
            if not Players:GetPlayerFromCharacter(v) and v.Humanoid.Health > 0 then
                local dist = (RootPart.Position - v.HumanoidRootPart.Position).Magnitude
                if dist < minDist and dist < Settings.AttackDistance then
                    nearest = v
                    minDist = dist
                end
            end
        end
    end
    return nearest
end

local function AttackMob(mob)
    if not mob or not mob:FindFirstChild("Humanoid") then return end
    
    local tool = Character:FindFirstChildOfClass("Tool")
    if not tool then
        for _, item in pairs(Player.Backpack:GetChildren()) do
            if item:IsA("Tool") then
                item.Parent = Character
                tool = item
                break
            end
        end
    end
    
    if tool then
        game:GetService("VirtualUser"):CaptureController()
        game:GetService("VirtualUser"):ClickButton2(Vector2.new())
        local hrp = mob.HumanoidRootPart
        RootPart.CFrame = CFrame.new(RootPart.Position, hrp.Position)
    end
end

local function AutoHeal()
    if not Settings.AutoHeal then return end
    
    for _, item in pairs(Player.Backpack:GetChildren()) do
        if item:IsA("Tool") and item:FindFirstChild("Heal") then
            if Humanoid.Health / Humanoid.MaxHealth * 100 < Settings.HealThreshold then
                item.Parent = Character
                task.wait(0.5)
                item.Parent = Player.Backpack
                break
            end
        end
    end
end

