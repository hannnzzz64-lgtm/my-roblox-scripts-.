function switchTab(tabName)
    for _, child in pairs(contentFrame:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("ScrollingFrame") then
            child:Destroy()
        end
    end
    
    for name, btn in pairs(tabButtons) do
        btn.BackgroundColor3 = (name == tabName) and Color3.fromRGB(70, 70, 140) or Color3.fromRGB(35, 35, 55)
        btn.TextColor3 = (name == tabName) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 220)
    end
    
    currentTab = tabName
    contentFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    
    if tabName == "Ultra" then
        createUltraTab()
    elseif tabName == "Combat" then
        createCombatTab()
    elseif tabName == "ESP" then
        createESPTab()
    elseif tabName == "Teleport" then
        createTeleportTab()
    elseif tabName == "Vehicle" then
        createVehicleTab()
    end
end

-- Helper untuk teleport ke lokasi berdasarkan nama part
local function teleportToLocation(locationName)
    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Cari part di workspace dengan nama yang cocok
    local target = Workspace:FindFirstChild(locationName)
    if target and target:IsA("BasePart") then
        hrp.CFrame = target.CFrame + Vector3.new(0, 3, 0) -- naikkan sedikit
    else
        warn("Lokasi " .. locationName .. " tidak ditemukan di workspace.")
    end
end

-- Helper untuk spawn senjata (model) dari ServerStorage atau Workspace
local function spawnWeapon(weaponName)
    local character = player.Character
    if not character then return end
    
    local model = ServerStorage:FindFirstChild(weaponName) or Workspace:FindFirstChild(weaponName)
    if model and model:IsA("Model") then
        local clone = model:Clone()
        clone.Parent = Workspace
        -- Taruh di depan karakter
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            clone:SetPrimaryPartCFrame(hrp.CFrame * CFrame.new(0, 0, -5))
        end
    else
        warn("Senjata " .. weaponName .. " tidak ditemukan.")
    end
end

function createToggle(labelText, yPos, defaultState)
    local frame = Instance.new("Frame")
