-- Anti-Kick / Anti-Detection System
local function antiKickBypass()
    -- Bypass standard kick methods
    local oldKick = game.Players.LocalPlayer.Kick
    game.Players.LocalPlayer.Kick = function(self, message)
        if message and message:lower():find("cheat") or message and message:lower():find("exploit") then
            return -- Block kick related to cheating
        else
            oldKick(self, message)
        end
    end
    
    -- Block RemoteEvent spam detection
    local oldFireServer = game:GetService("ReplicatedStorage").FindFirstChild("RemoteEvent") 
    if oldFireServer then
        getrawmetatable(game).__index = function(self, key)
            if key == "FireServer" then
                return function() end
            end
            return getrawmetatable(game).__index(self, key)
        end
    end
    
    -- Clear chat logs to prevent detection
    if game:GetService("Players").LocalPlayer.PlayerGui:FindFirstChild("Chat") then
        game:GetService("Players").LocalPlayer.PlayerGui.Chat:Destroy()
    end
end

-- Execute Anti-Kick
pcall(antiKickBypass)

