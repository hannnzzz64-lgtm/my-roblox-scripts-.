-- 6. Custom Name Tag (Menghilangkan nama asli Roblox & mengganti sesuai input Custom Name Text)
local function setupCustomName(char)
	if not customNameActive or not char then return end
	
	local head = char:WaitForChild("Head", 5)
	local humanoid = char:WaitForChild("Humanoid", 5)
	
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	
	if head and not head:FindFirstChild("HnxCustomNameTag") then
		local bb = Instance.new("BillboardGui")
		bb.Name = "HnxCustomNameTag"
		bb.Size = UDim2.new(0, 200, 0, 50)
		bb.StudsOffset = Vector3.new(0, 2.5, 0)
		bb.AlwaysOnTop = true
		bb.Parent = head
		
		local textLbl = Instance.new("TextLabel")
		textLbl.Name = "CustomNameText"
		textLbl.Size = UDim2.new(1, 0, 1, 0)
		textLbl.BackgroundTransparency = 1
		textLbl.Font = Enum.Font.SourceSansBold
		textLbl.Text = CustomNameBox.Text ~= "" and CustomNameBox.Text or ""
		textLbl.TextSize = 20
		textLbl.Parent = bb
	end
end

customNameBtn.MouseButton1Click:Connect(function()
	customNameActive = not customNameActive
	toggleState(customNameBtn, customNameCir, customNameActive)
	
	local char = LocalPlayer.Character
	local head = char and char:FindFirstChild("Head")
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	
	if customNameActive then
		setupCustomName(char)
	else
		if humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		end

		if head then
			local tag = head:FindFirstChild("HnxCustomNameTag")
			if tag then tag:Destroy() end
		end
	end
end)

-- Update teks secara real-time jika kotak teks diubah
CustomNameBox:GetPropertyChangedSignal("Text"):Connect(function()
	local char = LocalPlayer.Character
	local head = char and char:FindFirstChild("Head")
	if head then
		local tag = head:FindFirstChild("HnxCustomNameTag")
		if tag then
			local textLbl = tag:FindFirstChild("CustomNameText")
			if textLbl then
				textLbl.Text = CustomNameBox.Text
			end
		end
	end
end)

-- Auto re-apply saat karakter respawn jika aktif
LocalPlayer.CharacterAdded:Connect(function(newChar)
	if customNameActive then
		task.wait(0.5)
		setupCustomName(newChar)
	end
end)

-- Loop update warna pelangi (rainbow) untuk teks Custom Name di atas kepala
RunService.RenderStepped:Connect(function()
	if customNameActive then
		local char = LocalPlayer.Character
		local head = char and char:FindFirstChild("Head")
		if head then
			local tag = head:FindFirstChild("HnxCustomNameTag")
			if tag then
				local textLbl = tag:FindFirstChild("CustomNameText")
				if textLbl then
					local hue = (tick() % 5) / 5
					textLbl.TextColor3 = Color3.fromHSV(hue, 1, 1)
				end
			end
		end
	end
end)
