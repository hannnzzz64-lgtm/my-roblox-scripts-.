local Hyphon_Bypassed = false
local Start = tick()
local function HyphonBypass()
    local HandshakeFunctions = {}
    for Index, Object in next, getgc(false) do
        if (typeof(Object) == "function" and islclosure(Object)) then 
            local DebugInfo = debug.info(Object, "s")
            if DebugInfo:match("PlayerGui") and DebugInfo:match("%x+") then
                local Constants = debug.getconstants(Object)
                local UpValues = debug.getupvalues(Object)

                for Index, Constant in next, Constants do
                    if tostring(Constant):match("19996") or tostring(Constant):match("16379") then
                    end
                end
                if (#UpValues == 20 and #Constants > 140 and #Constants < 150) then
                    table.insert(HandshakeFunctions, Object)
                end
            end
        end
    end
    if (#HandshakeFunctions ~= 0 and #HandshakeFunctions >= 22) then
        for Index, Function in next, HandshakeFunctions do
            if Index == 2 then
                local Old
                Old = hookfunction(Function, function(...)
                    return table.unpack({})
                end)
            end
            if Index == 11 then
                local Old
                Old = hookfunction(Function, function(...)
                    local Args = {...}
                    local NewArgs = table.clone(Args)
                    NewArgs[2] = false
                    return table.unpack(NewArgs)
                end)
            end
        end
        Hyphon_Bypassed = true
    else
        warn("Code 404 | report in server")
        return
    end
end

