local GoalMemoryFile = "SBAutofarmV2_Goal_" .. LocalPlayer.Name .. ".txt"

local function FormatGoalCash(value)
    local formatted = tostring(math.floor(tonumber(value) or 0))
    local replacements
    repeat
        formatted, replacements = formatted:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
    until replacements == 0
    return formatted
end

local function ReadCurrentCash()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local main = playerGui and playerGui:FindFirstChild("Main")
    
    local hud = main and main:FindFirstChild("HUD")
    local background = hud and hud:FindFirstChild("Background")
    local moneyContainer = background and background:FindFirstChild("Money")
    
    local textObj = moneyContainer and moneyContainer:FindFirstChild("Amount")
    
    if not textObj and main then
        local money = main:FindFirstChild("Money")
        textObj = money and money:FindFirstChild("Amount")
    end
        
    if textObj and textObj.Text then
        local cleanedText = textObj.Text:gsub("[$,]", "")
        if cleanedText:find("%.") then
            cleanedText = cleanedText:split(".")[1]
        end
        return tonumber(cleanedText) or 0
    end
    return 0
end

local function ClearGoalMemory()
    if type(delfile) == "function" then
        pcall(delfile, GoalMemoryFile)
    end
end

local function SaveGoalMemory()
    if not GoalConfig.SaveGoal or type(writefile) ~= "function" then return end
    pcall(writefile, GoalMemoryFile, tostring(GoalConfig.TargetCash))
end

local function LoadGoalMemory()
    if not GoalConfig.SaveGoal or type(isfile) ~= "function" or type(readfile) ~= "function" then return end
    if isfile(GoalMemoryFile) then
        local saved = readfile(GoalMemoryFile)
        if tonumber(saved) then
            GoalConfig.TargetCash = math.clamp(math.floor(tonumber(saved)), 1, 1750000)
        end
    end
end

local UndergroundBaseplates = {}

local function __swnBP()
    local pos = {
        Vector3.new(0, -8.2, 0),
        Vector3.new(1321, -8.2, 660),
        Vector3.new(-919, -8.2, 659),
        Vector3.new(-898, -8.2, -652),
        Vector3.new(1364, -8.2, -639)
    }
    
    local size = Vector3.new(1e9, 5, 1e9)
    
    for _, position in ipairs(pos) do
        local partName = "UndergroundBP_" .. tostring(position)
        local baseplate = Workspace:FindFirstChild(partName)
        if not baseplate then
            baseplate = Instance.new("Part")
            baseplate.Name = partName
            baseplate.Size = size
            baseplate.Position = position
            baseplate.Anchored = true
            baseplate.CanCollide = true
            baseplate.BrickColor = BrickColor.new("Dark stone grey")
            baseplate.Material = Enum.Material.Concrete
            baseplate.Parent = Workspace
        end
        UndergroundBaseplates[baseplate] = true
    end
end

local function DeleteUndergroundBaseplates()
    for baseplate in pairs(UndergroundBaseplates) do
        if baseplate and baseplate.Parent then
            baseplate:Destroy()
        end
    end
    UndergroundBaseplates = {}
end

