    -- Fungsi cari marshmallow terdekat
    local function FindNearestMarshmallow()
        local nearest = nil
        local minDist = math.huge
        for _, v in pairs(game.Workspace:GetDescendants()) do
            if v:IsA("Model") and v.Name:lower():find("marshmallow") then
                local dist = (RootPart.Position - v.PrimaryPart.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = v
                end
            end
        end
        return nearest
    end
    
    -- Fungsi masak marshmallow di safe zone
    local function CookMarshmallow(marshmallow)
        if not marshmallow then return end
        local grill = game.Workspace:FindFirstChild("Grill") or game.Workspace:FindFirstChild("SafeZone")
        if grill and grill.PrimaryPart then
            RootPart.CFrame = grill.PrimaryPart.CFrame + Vector3.new(0, 5, 0)
            wait(1)
            -- Simulasi memasak
            local cookEvent = game:GetService("ReplicatedStorage"):FindFirstChild("CookEvent")
            if cookEvent then
                cookEvent:FireServer(marshmallow)
            end
            status.Text = "🍳 Memasak Marshmallow..."
            wait(3)
            status.Text = "✅ Selesai masak!"
        end
    end
    
    -- Auto Farm Loop
    autoFarmBtn.MouseButton1Click:Connect(function()
        isFarming = not isFarming
        autoFarmBtn.Text = isFarming and "⏹️ STOP FARM" or "🍬 AUTO FARM MARSHMALLOW"
        autoFarmBtn.BackgroundColor3 = isFarming and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 150, 100)
        status.Text = isFarming and "🔄 Farming aktif..." or "⏹️ Farming dihentikan"
        
        if isFarming then
            spawn(function()
                while isFarming do
                    local marsh = FindNearestMarshmallow()
                    if marsh then
                        CookMarshmallow(marsh)
                    else
                        status.Text = "🔍 Mencari marshmallow..."
                        wait(1)
                    end
                    wait(0.5)
                end
            end)
        end
    end)
    
    -- Auto Buy
    autoBuyBtn.MouseButton1Click:Connect(function()
        isBuying = not isBuying
        autoBuyBtn.Text = isBuying and "⏹️ STOP BUY" or "🛒 AUTO BUY MARSHMALLOW"
        autoBuyBtn.BackgroundColor3 = isBuying and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(150, 0, 200)
        
        if isBuying then
            spawn(function()
                while isBuying do
                    local buyEvent = game:GetService("ReplicatedStorage"):FindFirstChild("BuyMarshmallow")
                    if buyEvent then
                        buyEvent:FireServer()
                        status.Text = "💰 Membeli marshmallow..."
                        wait(2)
                    end
                    wait(1)
                end
            end)
        end
    end)
    
    -- Spawn Motor
    motorBtn.MouseButton1Click:Connect(function()
        local motorEvent = game:GetService("ReplicatedStorage"):FindFirstChild("SpawnVehicle")
        if motorEvent then
            motorEvent:FireServer("Motorcycle")
            status.Text = "🏍️ Motor berhasil di-spawn!"
        else
