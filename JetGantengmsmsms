-- ========== BYPASS ACTIVE (Anti Detect/Kick) ==========
local function BypassActive()
    -- Fake latency & spoof
    local oldNamecall = nil
    local mt = getrawmetatable and getrawmetatable(game) or debug.getmetatable(game)
    if mt then
        oldNamecall = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local args = {...}
            local method = getnamecallmethod()
            if method == "Kick" or method == "Ban" or method == "Teleport" then
                return
            end
            if oldNamecall then
                return oldNamecall(self, ...)
            end
        end)
        setreadonly(mt, true)
    end

    -- Bypass server checks
    for _, v in pairs(game:GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            if v.Name:lower():find("kick") or v.Name:lower():find("ban") or v.Name:lower():find("detect") then
                v:Destroy()
            end
        end
    end
    
    -- Fake ping
    game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:SetValue(30)
    game:GetService("Stats").Network.ServerStatsItem["Latency"]:SetValue(50)
    
    print("[JetGanteng] Bypass Active Berhasil!")
end

