local function CreateBackground()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "JetGantengGUI"
    screenGui.Parent = game.Players.LocalPlayer.PlayerGui
    
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(2, 0, 2, 0) -- Ukuran besar
    bg.Position = UDim2.new(-0.5, 0, -0.5, 0)
    bg.BackgroundColor3 = Color3.fromRGB(0, 50, 150)
    bg.BackgroundTransparency = 0.7
    bg.Parent = screenGui
    
    -- Efek pelangi bergerak
    local rainbow = Instance.new("Frame")
    rainbow.Size = UDim2.new(2.5, 0, 2.5, 0)
    rainbow.Position = UDim2.new(-0.75, 0, -0.75, 0)
    rainbow.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    rainbow.BackgroundTransparency = 0.5
    rainbow.Parent = screenGui
    
    -- Animasi pelangi
    spawn(function()
        local colors = {
            Color3.fromRGB(255, 0, 0),
            Color3.fromRGB(255, 165, 0),
            Color3.fromRGB(255, 255, 0),
            Color3.fromRGB(0, 255, 0),
            Color3.fromRGB(0, 0, 255),
            Color3.fromRGB(75, 0, 130),
            Color3.fromRGB(238, 130, 238)
        }
        local index = 1
        while wait(0.1) do
            rainbow.BackgroundColor3 = colors[index]
            rainbow.Rotation = (rainbow.Rotation or 0) + 1
            index = index % #colors + 1
        end
    end)
    
    return screenGui
end

