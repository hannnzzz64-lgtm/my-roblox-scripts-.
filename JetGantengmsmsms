            local vehicle = Instance.new("Model")
            vehicle.Name = "JetMotor"
            -- Tambahkan part sederhana
            local part = Instance.new("Part")
            part.Size = Vector3.new(3, 1, 5)
            part.Position = RootPart.Position + Vector3.new(0, 2, 5)
            part.Anchored = true
            part.Parent = vehicle
            vehicle.Parent = game.Workspace
            status.Text = "🏍️ Motor custom telah muncul!"
        end
    end)
    
    -- Tombol Main
    mainBtn.MouseButton1Click:Connect(function()
        status.Text = "🎮 Mode MAIN diaktifkan!"
