-- Konfigurasi Kecepatan (diperlambat agar tidak stuck)
local CONFIG = {
    TeleportDelay = 0.5,          -- Delay antar teleport
    ActionDelay = 0.8,            -- Delay antar aksi
    WaitDelay = 1.0,              -- Delay tunggu
    RandomDelayMin = 0.3,         -- Delay random minimum
    RandomDelayMax = 0.8,         -- Delay random maksimum
    WalkSpeed = 16,               -- Kecepatan jalan normal
    JumpPower = 50,               -- Kekuatan lompat
    MaxDistance = 30,             -- Jarak maksimum teleport
}

-- Fungsi Helper
local function RandomDelay()
    return CONFIG.RandomDelayMin + math.random() * (CONFIG.RandomDelayMax - CONFIG.RandomDelayMin)
end

local function WaitWithDelay()
    task.wait(CONFIG.WaitDelay + RandomDelay())
end

-- Fungsi Teleport dengan Tween (lebih smooth dan lambat)
local function Teleport(pos, instant)
    if not HRP then return end
    
    local currentPos = HRP.Position
    local distance = (pos.Position - currentPos).Magnitude
    
    -- Jika jarak terlalu jauh, teleport bertahap
    if distance > CONFIG.MaxDistance and not instant then
        local steps = math.min(math.floor(distance / 15), 8)
        for i = 1, steps do
            local lerpCF = HRP.CFrame:lerp(pos, i / steps)
            local tween = TweenService:Create(HRP, 
                TweenInfo.new(CONFIG.TeleportDelay * 0.5, Enum.EasingStyle.Linear), 
                {CFrame = lerpCF}
            )
            tween:Play()
            tween.Completed:Wait()
            task.wait(0.1 + RandomDelay() * 0.3)
            
            -- Cek jika stuck, lompat
            if HRP and (HRP.Position - currentPos).Magnitude < 1 then
                Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                task.wait(0.2)
            end
        end
    end
    
    -- Teleport akhir dengan tween
    local tween = TweenService:Create(HRP, 
        TweenInfo.new(CONFIG.TeleportDelay * (instant and 0.3 or 1), Enum.EasingStyle.Linear), 
        {CFrame = pos}
    )
    tween:Play()
    tween.Completed:Wait()
    task.wait(CONFIG.TeleportDelay * 0.5)
end

-- Fungsi Fire Proximity Prompt dengan delay
local function FirePrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") then
        task.wait(CONFIG.ActionDelay * 0.5 + RandomDelay() * 0.3)
        prompt:FireServer()
        task.wait(CONFIG.ActionDelay + RandomDelay() * 0.5)
        return true
    end
    return false
end

-- =============== BOX JOB ===============
local function BoxFarm()
    local positions = {
        start = CFrame.new(-552.45, 3.54, -83.86),
        drop = CFrame.new(-401.31, 3.41, -72.42),
    }
    
    local attempts = 0
    local maxAttempts = 3
    
    while farming and farmType == "Box" and isBoxFarming do
        task.wait(CONFIG.WaitDelay * 0.5)
        
        -- Ambil job
        if not LP:GetAttribute("WorkingJob") then
            attempts = 0
            Teleport(positions.start)
            WaitWithDelay()
            
            local prompt = Workspace:FindFirstChild("BoxJob") or Workspace:FindFirstChild("StartJob")
            if prompt then
                FirePrompt(prompt)
            end
            WaitWithDelay()
        end
        
        -- Bawa box ke drop point
        if LP:GetAttribute("WorkingJob") then
            Teleport(positions.drop)
            WaitWithDelay()
            
            local dropPrompt = Workspace:FindFirstChild("DropBox") or Workspace:FindFirstChild("BoxDrop")
            if dropPrompt then
                FirePrompt(dropPrompt)
                WaitWithDelay()
                attempts = 0
            end
        end
        
        -- Jika stuck, coba reset
        attempts = attempts + 1
        if attempts >= maxAttempts then
            -- Teleport ke spawn
            Teleport(CFrame.new(-552.45, 3.54, -83.86), true)
            task.wait(2)
            attempts = 0
        end
    end
end

-- =============== CONSTRUCTION JOB ===============
local function ConstructionFarm()
    local positions = {
        start = CFrame.new(-1729, 371, -1171),
        wood = CFrame.new(-1728, 371, -1178),
    }
    
    local attempts = 0
    local maxAttempts = 3
    
    while farming and farmType == "Construction" and isConstructionFarming do
        task.wait(CONFIG.WaitDelay * 0.5)
        
        -- Start Construction Job
        if not LP:GetAttribute("WorkingJob") then
            attempts = 0
            Teleport(positions.start)
            WaitWithDelay()
            
            local startPrompt = Workspace:FindFirstChild("ConstructionStuff") and Workspace.ConstructionStuff:FindFirstChild("Start Job")
            if startPrompt then
                FirePrompt(startPrompt)
            end
            WaitWithDelay()
        end
        
        -- Ambil Kayu
        if LP:GetAttribute("WorkingJob") then
            local hasWood = LP.Backpack:FindFirstChild("PlyWood") or LP.Character:FindFirstChild("PlyWood")
            if not hasWood then
                Teleport(positions.wood)
                WaitWithDelay()
                
                local woodPrompt = Workspace.ConstructionStuff:FindFirstChild("Grab Wood")
                if woodPrompt then
                    FirePrompt(woodPrompt)
                end
                WaitWithDelay()
            end
        end
        
        -- Bangun Tembok
        if LP:GetAttribute("WorkingJob") then
            local wall = Workspace.ConstructionStuff:FindFirstChild("Wall")
            if wall then
                local wallPos = CFrame.new(wall.Position + Vector3.new(0, 5, 0))
                Teleport(wallPos)
                WaitWithDelay()
                
                if wall:FindFirstChild("Prompt") then
                    FirePrompt(wall.Prompt)
                    WaitWithDelay()
                    attempts = 0
                end
            end
        end
        
        -- Jika stuck, coba reset
        attempts = attempts + 1
        if attempts >= maxAttempts then
            Teleport(positions.start, true)
            task.wait(2)
            attempts = 0
        end
    end
end

-- =============== MARSHMALLOW FARM ===============
local function MarshmallowFarm()
    local marshmallowPositions = {
        CFrame.new(-1361.33, 4.32, -952.24),
        CFrame.new(-1355.61, 4.35, -955.79),
        CFrame.new(-1348.21, 4.33, -953.01),
        CFrame.new(-1351.79, 4.31, -949.47),
        CFrame.new(-1359.21, 4.34, -947.98),
        CFrame.new(-1343.61, 4.36, -950.81),
        CFrame.new(-1367.42, 4.32, -955.13),
    }
    
    local currentIndex = 1
    local attempts = 0
    local maxAttempts = 5
    
    while farming and farmType == "Marshmallow" and isMarshmallowFarming do
        task.wait(CONFIG.WaitDelay * 0.3)
        
        -- Cari marshmallow terdekat
        local nearestMarsh = nil
        local nearestDist = math.huge
        
        for _, v in pairs(Workspace:GetDescendants()) do
            if v.Name == "Marshmallow" or v.Name == "MarshmallowCrate" then
                local pos = v:FindFirstChild("Position") or v:FindFirstChild("CFrame")
                if pos then
                    local dist = (HRP.Position - (pos.Position or pos.p)).Magnitude
                    if dist < nearestDist and dist < 100 then
                        nearestDist = dist
                        nearestMarsh = v
                    end
                end
            end
        end
        
        if nearestMarsh then
            -- Teleport ke marshmallow
            local marshPos = nearestMarsh:FindFirstChild("Position") or nearestMarsh:FindFirstChild("CFrame")
            if marshPos then
                Teleport(CFrame.new(marshPos.Position or marshPos.p))
                WaitWithDelay()
                
                -- Ambil marshmallow
                local prompt = nearestMarsh:FindFirstChild("Prompt") or nearestMarsh:FindFirstChild("ProximityPrompt")
                if prompt then
                    FirePrompt(prompt)
                    WaitWithDelay()
                    attempts = 0
                end
            end
        else
            -- Pindah ke posisi berikutnya jika tidak ada marshmallow
            if currentIndex > #marshmallowPositions then
                currentIndex = 1
            end
            
            Teleport(marshmallowPositions[currentIndex])
            WaitWithDelay()
            currentIndex = currentIndex + 1
        end
        
        -- Jika stuck, coba reset
        attempts = attempts + 1
        if attempts >= maxAttempts then
            Teleport(marshmallowPositions[1], true)
            task.wait(2)
            attempts = 0
        end
    end
end

-- =============== MAIN FARM LOOP ===============
local function StartFarm()
    if isRunning then return end
    isRunning = true
    farming = true
    
    -- Set kecepatan
    if Humanoid then
        Humanoid.WalkSpeed = CONFIG.WalkSpeed
        Humanoid.JumpPower = CONFIG.JumpPower
    end
    
    -- Aktifkan farm sesuai tipe
    if farmType == "Box" then
        isBoxFarming = true
        isConstructionFarming = false
        isMarshmallowFarming = false
        BoxFarm()
    elseif farmType == "Construction" then
        isBoxFarming = false
        isConstructionFarming = true
        isMarshmallowFarming = false
        ConstructionFarm()
    elseif farmType == "Marshmallow" then
        isBoxFarming = false
        isConstructionFarming = false
        isMarshmallowFarming = true
        MarshmallowFarm()
    end
    
    isRunning = false
    farming = false
end

local function StopFarm()
    farming = false
    isRunning = false
    isBoxFarming = false
    isConstructionFarming = false
    isMarshmallowFarming = false
end

